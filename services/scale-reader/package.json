{
  "name": "coop-scale-reader",
  "version": "1.0.0",
  "description": "Lecteur balance Yaohua A12E — service local RS232 → WebSocket/HTTP",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pm2:start": "pm2 start dist/index.js --name scale-reader --output logs/out.log --error logs/err.log",
    "pm2:stop": "pm2 stop scale-reader",
    "pm2:logs": "pm2 logs scale-reader"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "express": "^4.18.2",
    "serialport": "^12.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
